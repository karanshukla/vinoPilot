fetch "$ASSET"
if out="$(scoped_flatpak install -y "$tmp/$ASSET" 2>&1)"; then
    echo "$out"
else
    echo "$out"
    case "$out" in
        *"already installed"*) echo "This release's Flatpak is the one installed" ;;
        *) exit 1 ;;
    esac
fi
